# Test-Service — copy to .env (never commit .env)

APP_NAME=test-service
APP_VERSION=0.7.0
APP_PORT=8005
LOG_LEVEL=INFO

# Same JWT secret as Auth-Service / Offre-Service (user tokens)
JWT_SECRET=1234567890123456789012345678901234567890123456789012345678901234
JWT_ALGORITHM=HS256

# MySQL test_db
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/test_db

# Upstream services (HTTP)
OFFRE_SERVICE_URL=http://127.0.0.1:8084
USER_SERVICE_URL=http://127.0.0.1:8082
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8085
AUTH_SERVICE_URL=http://127.0.0.1:8081

# Optional internal key for workers / service-to-service
TEST_INTERNAL_API_KEY=dechli-test-internal-dev-key

# SMTP — e-mail candidat à la publication du score (même boîte qu’Auth-Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
FRONTEND_TESTS_URL=http://localhost:4200/candidate/tests

# LLM (Phase 1+) — use "mock" without API key for local/dev
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
